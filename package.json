{
  "name": "djir",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "npm run web:css && expo start --web",
    "web:css": "tailwindcss -c tailwind.web.config.js -i web.css -o public/tailwind.css --minify",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint .",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "mutants": "node scripts/mutants.mjs",
    "docs:shots": "node scripts/docs-shots.mjs"
  },
  "dependencies": {
    "@clerk/expo": "^4.7.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@neondatabase/serverless": "^0.9.4",
    "@stripe/stripe-react-native": "0.64.0",
    "expo": "^57.0.26",
    "expo-auth-session": "~57.0.13",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^2.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-places-autocomplete": "^2.5.6",
    "react-native-maps": "1.27.2",
    "react-native-maps-directions": "^1.9.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "stripe": "^16.7.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@electric-sql/pglite": "^0.2.17",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^18.0.7",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.5",
    "jest-util": "^29.7.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.3.2",
    "typescript": "~6.0.3"
