# ──────────────────────────────────────────────────────────────
# Djir — environment variables
# Copy this file to `.env.local` (git-ignored) and fill in your own values.
# EXPO_PUBLIC_* variables are bundled into the app: never put a secret in one.
# Everything else is read only by the API routes (server side).
# ──────────────────────────────────────────────────────────────

# Where the app calls its API routes (/(api)/…): the origin of your deployed
# Expo server. There is no default domain. Leave it empty for `npx expo start`
# and Expo Go: the app then calls the dev server that served it. Release iOS
# and Android builds must set it to your real origin; left empty there, their
# API calls fail rather than go to a guessed host. The web build can leave it
# empty.
EXPO_PUBLIC_API_ORIGIN=

# Authentication — Clerk (https://dashboard.clerk.com/ → API Keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# The instance's PEM public key (Clerk → API Keys → "Show JWT public key").
# API routes verify session tokens with it, without a network call.
# Keep it on one line with literal \n escapes.
CLERK_JWT_KEY=

# Signs price quotes so /ride/book charges exactly what was shown.
# Any random string of at least 32 characters, e.g. `openssl rand -hex 32`.
QUOTE_SIGNING_SECRET=

# Database — Neon serverless Postgres (https://neon.tech/ → connection string)
# Apply schema.sql (new database) or db/migrations/001_v1_1.sql (v1.0 database).
DATABASE_URL=

# Stripe (https://dashboard.stripe.com/apikeys) — use test keys in development.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Google Maps Platform (https://console.cloud.google.com/)
#   Places API: the From/To search.  Directions API: the booking route preview.
EXPO_PUBLIC_PLACES_API_KEY=
EXPO_PUBLIC_DIRECTIONS_API_KEY=
#   Maps SDK for Android: needed for maps in Android dev builds (build time only).
GOOGLE_MAPS_ANDROID_API_KEY=

# Geoapify — static map thumbnails in ride history (https://www.geoapify.com/)
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# Djir ML smart-pricing endpoint (see ml-platform/). Server-only.
# Unset, slow (> 2.5 s) or failing → /(api)/predict-price uses the TS heuristic.
#   local:  http://localhost:8000
ML_ENDPOINT_URL=

# Development builds only: play simulated rides N× faster (e.g. 20). Ignored in
# production builds.
EXPO_PUBLIC_TRACKING_SPEEDUP=
