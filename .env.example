# ──────────────────────────────────────────────────────────────
# Djir — environment variables
# Copy this file to `.env` and fill in your own values.
# Variables prefixed with EXPO_PUBLIC_ are bundled into the client.
# Variables WITHOUT that prefix are server-only (API routes).
# ──────────────────────────────────────────────────────────────

# Authentication — Clerk (https://dashboard.clerk.com/ → API Keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Database — Neon serverless Postgres (https://neon.tech/ → connection string)
DATABASE_URL=

# Google Maps Platform (https://console.cloud.google.com/)
#   Enable "Places API" and "Directions API", then create API keys.
EXPO_PUBLIC_PLACES_API_KEY=
EXPO_PUBLIC_DIRECTIONS_API_KEY=

# Geoapify — reverse geocoding (https://www.geoapify.com/ → API Keys)
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# Stripe (https://dashboard.stripe.com/apikeys)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Djir ML smart-pricing endpoint (see ml-platform/). Server-only.
# If unset, /(api)/predict-price falls back to a deterministic heuristic.
#   local:  http://localhost:8000
ML_ENDPOINT_URL=
